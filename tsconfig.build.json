{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "allowImportingTsExtensions": false
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    "storybook-static",
    "src/**/*.test.ts",
    "src/**/*.stories.tsx",
    "src/**/*.mdx",
    "src/stories"
  ]
}
